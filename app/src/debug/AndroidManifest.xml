<?xml version="1.0" encoding="utf-8"?>
<!-- 互換試験用の画面はdebugビルドだけに入れる。IMEと別processにしてInputConnectionをプロセス間で試す。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".compat.CompatEditTextActivity"
            android:exported="true"
            android:label="@string/compat_edittext_title"
            android:process=":compat"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".compat.CompatWebViewActivity"
            android:exported="true"
            android:label="@string/compat_webview_title"
            android:process=":compat"
            android:windowSoftInputMode="adjustResize" />
        <!-- Phase 2cの課題入力画面。adbから課題IDを付けて開くたびに欄を空にする。 -->
        <activity
            android:name=".compat.Phase2cTaskActivity"
            android:exported="true"
            android:label="@string/phase2c_task_title"
            android:launchMode="singleTop"
            android:process=":compat"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize" />
        <!-- Phase 2cの評価用計数の受信口。IMEと同じprocessで動く。DUMP権限を持つadb shellからだけ送れる。 -->
        <receiver
            android:name=".compat.EvaluationCounterReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
