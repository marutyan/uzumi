<?xml version="1.0" encoding="utf-8"?>
<!-- キーボードのライト配色（Gboard標準テーマの実測値）。ダーク配色は values-night/colors.xml に同じ名前で置く。 -->
<resources>
    <color name="kb_background">#FFF0F4F9</color>
    <color name="kb_key">#FFFFFFFF</color>
    <color name="kb_key_pressed">#FFD3E3FD</color>
    <color name="kb_function">#FFE1E3E1</color>
    <color name="kb_function_pressed">#FFD3E3FD</color>
    <!-- Shiftなど、有効な状態を示すキーの背景 -->
    <color name="kb_key_active">#FFD3E3FD</color>
    <color name="kb_accent">#FF0B57D0</color>
    <color name="kb_accent_pressed">#FF0A50BF</color>
    <color name="kb_on_accent">#FFFFFFFF</color>
    <color name="kb_text">#FF1F1F1F</color>
    <color name="kb_text_secondary">#FF444746</color>
    <!-- 押したキーの拡大表示 -->
    <color name="kb_popup">#FF0B57D0</color>
    <color name="kb_on_popup">#FFFFFFFF</color>
    <!-- 削除キーの左ドラッグで、離すと行頭まで消える状態の案内 -->
    <color name="kb_danger">#FFB3261E</color>
    <color name="kb_on_danger">#FFFFFFFF</color>
    <!-- 候補バーの背景と、候補一覧の区切り線 -->
    <color name="kb_bar">#FFF0F4F9</color>
    <color name="kb_divider">#FFC4C7C5</color>
    <!-- フリックの吹き出しの地色（Simejiと同じ灰色） -->
    <color name="kb_flick">#FF8A8A8A</color>
</resources>
