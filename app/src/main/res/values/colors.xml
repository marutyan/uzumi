<?xml version="1.0" encoding="utf-8"?>
<!-- キーボードのライト配色（Gboard標準テーマの実測値）。ダーク配色は values-night/colors.xml に同じ名前で置く。 -->
<resources>
    <color name="kb_background">#FFF0F4F9</color>
    <color name="kb_key">#FFFFFFFF</color>
    <color name="kb_key_pressed">#FFD3E3FD</color>
    <color name="kb_function">#FFE1E3E1</color>
    <color name="kb_function_pressed">#FFD3E3FD</color>
    <!-- Shiftなど、有効な状態を示すキーの背景 -->
    <color name="kb_key_active">#FFD3E3FD</color>
    <color name="kb_accent">#FF0B57D0</color>
    <color name="kb_accent_pressed">#FF0A50BF</color>
    <color name="kb_on_accent">#FFFFFFFF</color>
    <color name="kb_text">#FF1F1F1F</color>
    <color name="kb_text_secondary">#FF444746</color>
    <!-- 押したキーの拡大表示 -->
    <color name="kb_popup">#FF0B57D0</color>
    <color name="kb_on_popup">#FFFFFFFF</color>
    <!-- 削除キーの左ドラッグで、離すと行頭まで消える状態の案内 -->
    <color name="kb_danger">#FFB3261E</color>
    <color name="kb_on_danger">#FFFFFFFF</color>
    <!-- 候補バーの背景と、候補一覧の区切り線 -->
    <color name="kb_bar">#FFF0F4F9</color>
    <color name="kb_divider">#FFC4C7C5</color>
    <!-- フリックの吹き出しの地色（Simejiと同じ灰色） -->
    <color name="kb_flick">#FF8A8A8A</color>
    <!--
      設定画面と起動画面の配色。キーボードの標準テーマの色を元にし、同じ値の役割はキーボードの色を参照する。
      行の地・選択中の地の上の文字・部品の枠だけはキーボードに無い色のため、ここで値を持つ。本文と説明文は行の地と画面の地の両方に対して4.5:1以上。
    -->
    <color name="settings_background">@color/kb_background</color>
    <color name="settings_surface">#FFFFFFFF</color>
    <color name="settings_surface_high">@color/kb_function</color>
    <color name="settings_text">@color/kb_text</color>
    <color name="settings_text_secondary">@color/kb_text_secondary</color>
    <color name="settings_accent">@color/kb_accent</color>
    <color name="settings_on_accent">@color/kb_on_accent</color>
    <color name="settings_accent_container">@color/kb_key_active</color>
    <color name="settings_on_accent_container">#FF0842A0</color>
    <color name="settings_outline">#FF747775</color>
    <color name="settings_divider">@color/kb_divider</color>
    <color name="settings_danger">@color/kb_danger</color>
</resources>
