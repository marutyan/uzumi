<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Uzumi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#345995</item>
        <item name="android:statusBarColor">#F4F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F4F5F7</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- 設定画面は端末のライト／ダーク設定に従う。キーボードと同じく端末の見た目に合わせるため。 -->
    <style name="Theme.Uzumi.Settings" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">@color/kb_accent</item>
    </style>
    <!--
      起動画面と設定画面。端末のライト／ダーク設定に従い、見出しの帯（戻るボタンと題名）は画面の中で描くため、Activityの帯は出さない。
      ステータスバーとナビゲーションバーのアイコンの明暗は、地の色に合わせて values-night で切り替える。
    -->
    <style name="Theme.Uzumi.SettingsPage" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/settings_background</item>
        <item name="android:colorBackground">@color/settings_background</item>
        <item name="android:colorAccent">@color/settings_accent</item>
        <item name="android:windowLightStatusBar">@bool/settings_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/settings_light_system_bars</item>
    </style>
</resources>
