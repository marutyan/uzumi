<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Uzumi" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#345995</item>
        <item name="android:statusBarColor">#F4F5F7</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#F4F5F7</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <!-- 設定画面は端末のライト／ダーク設定に従う。キーボードと同じく端末の見た目に合わせるため。 -->
    <style name="Theme.Uzumi.Settings" parent="android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">@color/kb_accent</item>
    </style>
</resources>
