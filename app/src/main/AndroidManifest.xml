<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 端末内音声入力のためにマイク録音権限だけを求め、通信権限（INTERNET）は持たない。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 音声翻訳のML Kitが足す通信の権限を外す。翻訳は端末内で行い、モデルの取得は端末のAICoreが行うため通信は要らない。 -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <!-- 端末内の既定音声認識サービス（Android System Intelligence等）を照会するために宣言する。 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_uzumi"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_uzumi"
        android:supportsRtl="true"
        android:theme="@style/Theme.Uzumi">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UserDictionaryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".LicenseActivity"
            android:exported="false" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Uzumi.Settings" />
        <activity
            android:name=".KisekaeActivity"
            android:exported="false"
            android:theme="@style/Theme.Uzumi.Settings" />
        <!-- IMEから録音権限ダイアログを出すための最小画面。 -->
        <activity
            android:name=".voice.VoicePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Uzumi.Settings" />

        <service
            android:name=".UzumiInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/input_method" />
        </service>

        <!-- ニューラル変換の推論を行う別プロセスのservice。IMEだけがbindする。モデルを選ばない限り起動しない。 -->
        <service
            android:name=".neural.NeuralRuntimeService"
            android:exported="false"
            android:process=":neural" />
    </application>
</manifest>
